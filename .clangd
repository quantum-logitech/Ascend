# clangd configuration for ccec / bisheng .asc sources.
#
# The flags that make the asc dialect understandable live in ./compile_flags.txt,
# which is generated by .vscode/ccec-ide/gen_ide_env.sh. This file only tunes
# clangd's behaviour; it is deliberately free of absolute paths so it stays
# valid on any machine.

CompileFlags:
  # .asc has no registered language, so compile_flags.txt forces -xc++.
  # Accept it and keep parsing past the dialect-specific constructs that a stock
  # clang frontend cannot represent.
  Add:
    - -ferror-limit=0

Diagnostics:
  # The user's own kernels do not include CANN headers they already get
  # transitively through the generated prelude.
  UnusedIncludes: None
  MissingIncludes: None

Index:
  Background: Build

InlayHints:
  # Block-end / parameter hints add noise in register-heavy vector code.
  BlockEnd: false
  ParameterNames: false
