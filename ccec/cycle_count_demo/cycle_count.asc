/* !
 * \file cycle_count.asc
 * \brief 最小 cycle 统计样例：直接使用 ccec 编译器内建 get_sys_cnt() 统计各阶段耗时，
 *        不经过 asc_get_system_cycle() 等二次封装接口。
 *
 * 关键点（3510 后端约束，实测验证）：
 *  1. get_sys_cnt() 是 ccec 编译器内建（clang_builtin_alias(__builtin_cce_get_sys_cnt)），
 *     在 device 代码中可直接调用，无需包含额外头文件。
 *  2. 必须用 __attribute__((noinline)) 包装，否则 Release(-O2/-O3) 下编译器会把
 *     多次 get_sys_cnt() 调用做 CSE/常量折叠，导致各时间戳相等、cycle 差值为 0。
 *  3. get_sys_cnt()（标量操作）必须留在 __vector__ kernel 主体（标量上下文）；
 *     所有 vector 指令（vlds/vadd/vsts 等）必须放在独立的 __simd_vf__ 函数中，
 *     二者不能混写在同一个 kernel 主体，否则后端报
 *     "Do not know how to split the result of this operator!"。
 */

#include <cstdint>
#include <vector>

#include <iostream>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t TOTAL_LENGTH = 25600;  // 100KB float
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t OUT_ALIGN_SIZE = 8;

__aicore__ constexpr uint32_t ceil_division(uint32_t numerator, uint32_t denominator)
{
    return (numerator + denominator - 1) / denominator;
}

// 阻止编译器对 get_sys_cnt() 做 CSE/常量折叠优化
__attribute__((noinline)) __aicore__ int64_t get_sys_cnt_safe()
{
    return get_sys_cnt();
}

// 一个轻量 vector 计算：加载第一个向量、自加、写回（仅演示 cycle 差异）。
// 注意：所有 vector 指令必须放在 __simd_vf__ 函数内，不能与 get_sys_cnt() 混在 kernel 主体。
__simd_vf__ inline void vec_compute(__ubuf__ float* x_local)
{
    vector_bool vmask = pset_b32(PAT_ALL);
    vector_float src_reg;
    vector_float dst_reg;
    vlds(src_reg, x_local, 0, NORM);
    vadd(dst_reg, src_reg, src_reg, vmask, MODE_ZEROING);
    vsts(dst_reg, x_local, 0, NORM_B32, vmask);
}

__vector__ __global__ void cycle_count_custom(__gm__ float* x, __gm__ float* y, __gm__ int64_t* cycles)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;

    __gm__ float* x_gm = x + block_idx * block_length;
    __gm__ float* y_gm = y + block_idx * OUT_ALIGN_SIZE;

    __ubuf__ float x_local[block_length];
    __ubuf__ float y_local[OUT_ALIGN_SIZE];

    // t0: 起点
    int64_t t0 = get_sys_cnt_safe();

    // GM->UB 搬运
    asc_copy_gm2ub_align((__ubuf__ float*)x_local, x_gm, 1, block_length * sizeof(float), 0, 0, false, 0, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    int64_t t1 = get_sys_cnt_safe();

    // vector 计算（放在 __simd_vf__ 函数内）
    vec_compute((__ubuf__ float*)x_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    int64_t t2 = get_sys_cnt_safe();

    // UB->GM 搬出
    asc_copy_ub2gm_align(y_gm, (__ubuf__ float*)y_local, 1, OUT_ALIGN_SIZE * sizeof(float), 0, 0, 0);
    asc_sync();
    int64_t t3 = get_sys_cnt_safe();

    cycles[0] = t1 - t0;  // GM->UB
    cycles[1] = t2 - t1;  // 计算
    cycles[2] = t3 - t0;  // 总耗时
    cycles[3] = t3 - t2;  // UB->GM
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    constexpr uint32_t cycle_count = 4;
    size_t input_byte_size = total_length * sizeof(float);
    size_t output_byte_size = NUM_BLOCKS * OUT_ALIGN_SIZE * sizeof(float);
    int32_t device_id = 0;

    std::vector<float> x(total_length, 1.0f);

    uint8_t* x_host = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* y_host = nullptr;
    int64_t* cycles_host = nullptr;
    float* x_device = nullptr;
    float* y_device = nullptr;
    int64_t* cycles_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&y_host), output_byte_size);
    aclrtMallocHost((void**)(&cycles_host), cycle_count * sizeof(int64_t));
    aclrtMalloc((void**)&x_device, input_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, output_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cycles_device, cycle_count * sizeof(int64_t), ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(x_device, input_byte_size, x_host, input_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    cycle_count_custom<<<NUM_BLOCKS, 0>>>(x_device, y_device, cycles_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(cycles_host, cycle_count * sizeof(int64_t), cycles_device, cycle_count * sizeof(int64_t),
                ACL_MEMCPY_DEVICE_TO_HOST);

    std::cout << "Kernel cycle stats (get_sys_cnt, AI Core cycles):" << std::endl;
    std::cout << "  GM->UB copy : " << cycles_host[0] << " cycles" << std::endl;
    std::cout << "  compute      : " << cycles_host[1] << " cycles" << std::endl;
    std::cout << "  UB->GM copy : " << cycles_host[3] << " cycles" << std::endl;
    std::cout << "  kernel total: " << cycles_host[2] << " cycles" << std::endl;

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFree(cycles_device);
    aclrtFreeHost(y_host);
    aclrtFreeHost(cycles_host);

    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
