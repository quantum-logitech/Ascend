/* !
 * \file fill_zero.asc
 * \brief UB 大块（> 256B = 1 个 VF 帧）fill 0 的 cycle 对比样例。
 *
 * 目标问题（供性能分析）：
 *   对一块大于 256B 的 UB 空间填 0，哪种写法在 3510 (V300 VF) 上最省 cycle？
 *   候选方向：
 *     A. 是否存在"硬件指令直接给整块 UB 填 0"（一条指令/一个接口写整块）？
 *        调研结论：3510 的 c_api 只暴露寄存器级 duplicate
 *        （asc_duplicate_scalar / cce 内建 vdup：标量广播成一个全零向量寄存器），
 *        没有公开的"ubuf dst 整块 fill"指令；因此整块 fill 必须拆成
 *        "生成全零寄存器 + 逐 256B 帧 vsts"。
 *     B. 全零寄存器是否只生成一次、循环里反复 store 即可？（本样例对比：生成一次 vs 每帧生成）
 *     C. 是否能用 load 的 mask+init 顺带造出全零寄存器、省掉 vdups？
 *        调研结论：V300 的 vlds 不带 predication/mask（无 init 语义，见 plt_demo 注释），
 *        此路径不可用；本样例以"寄存器提升到循环外"逼近 C 想验证的收益。
 *
 * 样例内容：同一块 16KB（4096 float，> 256B）UB 空间，4 种 fill0 写法各填 8 轮，
 *   统计每轮平均 cycle，并搬回 GM 逐元素校验是否全 0：
 *     v0: c_api 风格，每帧 asc_duplicate_scalar 生成零寄存器 + asc_storealign（零寄存器未提升）
 *     v1: c_api 风格，零寄存器生成一次提出循环，循环内仅 asc_storealign
 *     v2: cce  内建，每帧 vdup 生成零寄存器 + vsts（零寄存器未提升）
 *     v3: cce  内建，零寄存器 vdup 一次提出循环，循环内仅 vsts
 *
 * 关键约束（3510 后端实测，与 reduce_demo/cycle_count_demo 一致）：
 *  1. vector 指令（vdup/vsts/vlds 等）必须放在独立的 __simd_vf__ 函数中；
 *     get_sys_cnt() 等标量操作留在 __vector__ kernel 主体，二者不可混写，
 *     否则后端报 "Do not know how to split the result of this operator!"。
 *  2. get_sys_cnt() 是 ccec 编译器内建，必须用 __attribute__((noinline)) 包装，
 *     防止 Release(-O2/-O3) 下 CSE/常量折叠导致各时间戳相等。
 *  3. get_sys_cnt() 走 PIPE_S 标量流水，与被测 PIPE_V 异步；每次读计数器前
 *     必须插入 PIPE_V -> PIPE_S 同步（asc_sync_notify + asc_sync_wait），
 *     否则 cycle 差值偏小甚至为 0。
 *  4. __simd_vf__ 函数体内只用 for 直落循环（不写 if/while + 向量指令混排），
 *     规避 plt_demo 记录的后端段错误。
 *
 * 构建/运行（npu 模式，dav-3510）：
 *   cmake -B build -DCMAKE_ASC_RUN_MODE=npu -DCMAKE_ASC_ARCHITECTURES=dav-3510
 *   cmake --build build
 *   ./build/demo [device_id]
 */

#include <cstdint>
#include <vector>
#include <iostream>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

// 被测块长：4096 个 float = 16KB（> 256B，即多于 1 个 VF 帧；VL=256B）
constexpr uint32_t FILL_LEN = 4096;
// 3510 一帧 = 256B；b32（float）一帧 = 64 lane
constexpr uint32_t VL_BYTES = 256;
// 每轮 fill 的轮数（统计总 cycle 后取平均，摊薄时间戳开销）
constexpr uint32_t ITERATIONS = 8;
// fill 候选变体数（v0..v3）
constexpr uint32_t NUM_VARIANTS = 4;
// 逻辑核数：1，单 AI Core 分析
constexpr uint32_t NUM_BLOCKS = 1;

// 阻止编译器对 get_sys_cnt() 做 CSE/常量折叠优化
__attribute__((noinline)) __aicore__ int64_t get_sys_cnt_safe()
{
    return get_sys_cnt();
}

// ---------------------------------------------------------------------------
// fill0 候选实现（全部在 __simd_vf__ 内；frames = 帧数，one_rep_size = 每帧 float 数）
// 被测 UB 区已预置为 1.0f（由 kernel 主体 GM->UB 搬入），fill 后应为全 0。
// ---------------------------------------------------------------------------

// v0: c_api 风格，每帧重新生成零寄存器（asc_duplicate_scalar -> vdup 语义）
__simd_vf__ inline void fill0_capi_perframe(
    __ubuf__ float* buf, uint32_t iterations, uint32_t frames, uint16_t one_rep_size)
{
    vector_bool all_mask = asc_create_mask_b32(PAT_ALL);
    vector_float zero_reg;
    for (uint32_t p = 0; p < iterations; ++p) {
        for (uint32_t i = 0; i < frames; ++i) {
            asc_duplicate_scalar(zero_reg, 0.0f, all_mask);                       // 生成全零寄存器（每帧一次）
            asc_storealign(buf + i * one_rep_size, zero_reg, all_mask);            // 存一整帧 (256B)
        }
    }
}

// v1: c_api 风格，零寄存器生成一次，循环内只 store
__simd_vf__ inline void fill0_capi_hoisted(
    __ubuf__ float* buf, uint32_t iterations, uint32_t frames, uint16_t one_rep_size)
{
    vector_bool all_mask = asc_create_mask_b32(PAT_ALL);
    vector_float zero_reg;
    asc_duplicate_scalar(zero_reg, 0.0f, all_mask);                                // 生成一次
    for (uint32_t p = 0; p < iterations; ++p) {
        for (uint32_t i = 0; i < frames; ++i) {
            asc_storealign(buf + i * one_rep_size, zero_reg, all_mask);            // 循环内仅 store
        }
    }
}

// v2: cce 内建，每帧 vdup 生成零寄存器 + vsts（零寄存器未提升）
__simd_vf__ inline void fill0_cce_perframe(
    __ubuf__ float* buf, uint32_t iterations, uint32_t frames, uint16_t one_rep_size)
{
    vector_bool vmask = pset_b32(PAT_ALL);
    vector_float zero_reg;
    for (uint32_t p = 0; p < iterations; ++p) {
        for (uint32_t i = 0; i < frames; ++i) {
            vdup(zero_reg, 0.0f, vmask, MODE_ZEROING);                             // 每帧生成全零寄存器
            vsts(zero_reg, buf + i * one_rep_size, 0, NORM_B32, vmask);            // 存一整帧 (256B)
        }
    }
}

// v3: cce 内建，零寄存器 vdup 一次提出循环，循环内仅 vsts
__simd_vf__ inline void fill0_cce_hoisted(
    __ubuf__ float* buf, uint32_t iterations, uint32_t frames, uint16_t one_rep_size)
{
    vector_bool vmask = pset_b32(PAT_ALL);
    vector_float zero_reg;
    vdup(zero_reg, 0.0f, vmask, MODE_ZEROING);                                     // 生成一次
    for (uint32_t p = 0; p < iterations; ++p) {
        for (uint32_t i = 0; i < frames; ++i) {
            vsts(zero_reg, buf + i * one_rep_size, 0, NORM_B32, vmask);            // 循环内仅 store
        }
    }
}

// kernel 主体（标量上下文）：预置 1.0f -> 逐变体 fill0 计时 -> 搬回 GM 校验
// 每个变体用独立的 UB 缓冲 + 独立的 GM 输出段，避免互相干扰
__vector__ __global__ void fill_zero_kernel(
    __gm__ float* x, __gm__ float* y, __gm__ int64_t* cycles)
{
    asc_init();

    constexpr uint32_t bytes = FILL_LEN * sizeof(float);
    __ubuf__ float ub0[FILL_LEN];
    __ubuf__ float ub1[FILL_LEN];
    __ubuf__ float ub2[FILL_LEN];
    __ubuf__ float ub3[FILL_LEN];

    // GM 输入全 1.0f -> UB（预置非零，fill 后才能区分"写了 0"与"没写"）
    asc_copy_gm2ub_align((__ubuf__ float*)ub0, x, 1, bytes, 0, 0, false, 0, 0, 0);
    asc_copy_gm2ub_align((__ubuf__ float*)ub1, x, 1, bytes, 0, 0, false, 0, 0, 0);
    asc_copy_gm2ub_align((__ubuf__ float*)ub2, x, 1, bytes, 0, 0, false, 0, 0, 0);
    asc_copy_gm2ub_align((__ubuf__ float*)ub3, x, 1, bytes, 0, 0, false, 0, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    uint16_t one_rep_size = asc_get_vf_len() / sizeof(float);  // 3510: 256B/4B = 64 lane/帧
    uint32_t frames = FILL_LEN / one_rep_size;                 // 16KB/256B = 64 帧

    // ---- v0: c_api per-frame ----
    int64_t s0 = get_sys_cnt_safe();
    fill0_capi_perframe((__ubuf__ float*)ub0, ITERATIONS, frames, one_rep_size);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID1);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID1);
    int64_t e0 = get_sys_cnt_safe();

    // ---- v1: c_api hoisted ----
    int64_t s1 = get_sys_cnt_safe();
    fill0_capi_hoisted((__ubuf__ float*)ub1, ITERATIONS, frames, one_rep_size);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID1);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID1);
    int64_t e1 = get_sys_cnt_safe();

    // ---- v2: cce per-frame ----
    int64_t s2 = get_sys_cnt_safe();
    fill0_cce_perframe((__ubuf__ float*)ub2, ITERATIONS, frames, one_rep_size);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID1);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID1);
    int64_t e2 = get_sys_cnt_safe();

    // ---- v3: cce hoisted ----
    int64_t s3 = get_sys_cnt_safe();
    fill0_cce_hoisted((__ubuf__ float*)ub3, ITERATIONS, frames, one_rep_size);
    asc_sync_notify(PIPE_V, PIPE_S, EVENT_ID1);
    asc_sync_wait(PIPE_V, PIPE_S, EVENT_ID1);
    int64_t e3 = get_sys_cnt_safe();

    cycles[0] = e0 - s0;  // v0 总 cycle（ITERATIONS 轮）
    cycles[1] = e1 - s1;
    cycles[2] = e2 - s2;
    cycles[3] = e3 - s3;

    // UB -> GM 搬出（各变体输出到独立段，host 校验是否全 0）
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(y, (__ubuf__ float*)ub0, 1, bytes, 0, 0, 0);
    asc_copy_ub2gm_align(y + FILL_LEN, (__ubuf__ float*)ub1, 1, bytes, 0, 0, 0);
    asc_copy_ub2gm_align(y + 2 * FILL_LEN, (__ubuf__ float*)ub2, 1, bytes, 0, 0, 0);
    asc_copy_ub2gm_align(y + 3 * FILL_LEN, (__ubuf__ float*)ub3, 1, bytes, 0, 0, 0);
    asc_sync_notify(PIPE_MTE3, PIPE_S, EVENT_ID1);
    asc_sync_wait(PIPE_MTE3, PIPE_S, EVENT_ID1);
    int64_t t_end = get_sys_cnt_safe();
    cycles[4] = t_end - e3;  // 搬出耗时（参考）

    asc_sync();
}

// ---------------------------------------------------------------------------
// Host 侧
// ---------------------------------------------------------------------------
int32_t main(int32_t argc, char* argv[])
{
    int32_t device_id = 0;
    if (argc > 1) {
        device_id = std::atoi(argv[1]);
    }

    constexpr size_t in_bytes = FILL_LEN * sizeof(float);
    constexpr size_t out_bytes = NUM_VARIANTS * FILL_LEN * sizeof(float);
    constexpr size_t cycle_count = 5;

    // host 输入：全 1.0f（预置非零）
    std::vector<float> x(FILL_LEN, 1.0f);

    uint8_t* y_host = nullptr;
    int64_t* cycles_host = nullptr;
    float* x_device = nullptr;
    float* y_device = nullptr;
    int64_t* cycles_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&y_host), out_bytes);
    aclrtMallocHost((void**)(&cycles_host), cycle_count * sizeof(int64_t));
    aclrtMalloc((void**)&x_device, in_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, out_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cycles_device, cycle_count * sizeof(int64_t), ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(x_device, in_bytes, x.data(), in_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    fill_zero_kernel<<<NUM_BLOCKS, 0>>>(x_device, y_device, cycles_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(y_host, out_bytes, (uint8_t*)y_device, out_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(cycles_host, cycle_count * sizeof(int64_t), (uint8_t*)cycles_device, cycle_count * sizeof(int64_t),
                ACL_MEMCPY_DEVICE_TO_HOST);

    // 打印 cycle 统计：每轮平均 = 总 cycle / ITERATIONS
    const char* names[NUM_VARIANTS] = {"c_api per-frame", "c_api hoisted  ", "cce   per-frame", "cce   hoisted  "};
    std::cout << "Fill0 UB " << FILL_LEN * sizeof(float) << "B (" << FILL_LEN / (VL_BYTES / sizeof(float))
              << " frames), iterations = " << ITERATIONS << std::endl;
    for (uint32_t v = 0; v < NUM_VARIANTS; ++v) {
        std::cout << "  v" << v << " [" << names[v] << "]: total " << cycles_host[v] << " cycles, per-fill "
                  << (cycles_host[v] / (int64_t)ITERATIONS) << " cycles" << std::endl;
    }
    std::cout << "  UB->GM copy (reference): " << cycles_host[4] << " cycles" << std::endl;

    // 正确性校验：4 段输出都必须全 0
    uint32_t fail_cnt = 0;
    for (uint32_t v = 0; v < NUM_VARIANTS; ++v) {
        const float* seg = (const float*)y_host + v * FILL_LEN;
        for (uint32_t i = 0; i < FILL_LEN; ++i) {
            if (seg[i] != 0.0f) {
                ++fail_cnt;
                if (fail_cnt <= 8) {
                    std::cout << "  [FAIL] v" << v << " y[" << i << "] = " << seg[i] << std::endl;
                }
            }
        }
    }
    if (fail_cnt == 0) {
        std::cout << "Verification: all " << NUM_VARIANTS << " variants are zero. test pass!" << std::endl;
    } else {
        std::cout << "Verification: " << fail_cnt << " nonzero elements. test fail!" << std::endl;
    }

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFree(cycles_device);
    aclrtFreeHost(y_host);
    aclrtFreeHost(cycles_host);

    aclrtResetDevice(device_id);
    aclFinalize();
    return (fail_cnt == 0) ? 0 : 1;
}
